generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  INVENTORY_MANAGER
  ORDER_STAFF
  ACCOUNTANT
  ANALYST
  PLATFORM_OPERATOR
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum MoveType {
  OPENING
  RECEIPT
  RESERVE
  RELEASE
  DISPATCH
  ADJUST
  DAMAGE
  RETURN_RESTOCK
}

model Organization {
  id String @id @default(cuid())
  name String
  suspended Boolean @default(false)
  createdAt DateTime @default(now())
  members Membership[]
  products Product[]
  orders Order[]
  warehouses Warehouse[]
  suppliers Supplier[]
  purchases PurchaseOrder[]
  returns Return[]
  invitations   Invitation[]
  receipts      GoodsReceipt[]
  notifications Notification[]
  plan          String         @default("FREE")
}

model User {
  id String @id @default(cuid())
  authId String @unique
  email String @unique
  name String?
  createdAt DateTime @default(now())
  memberships Membership[]
}

model Membership {
  id String @id @default(cuid())
  userId String
  orgId String
  role Role
  user User @relation(fields: [userId], references: [id])
  org Organization @relation(fields: [orgId], references: [id])
  @@unique([userId, orgId])
  @@index([orgId])
}

model Warehouse {
  id String @id @default(cuid())
  orgId String
  name String
  org Organization @relation(fields: [orgId], references: [id])
  balances StockBalance[]
  @@index([orgId])
}

model Product {
  id String @id @default(cuid())
  orgId String
  sku String
  name String
  hsn String?
  unitCost Decimal @db.Decimal(12,2)
  price Decimal @db.Decimal(12,2)
  reorderAt Int @default(0)
  archived Boolean @default(false)
  org Organization @relation(fields: [orgId], references: [id])
  balances StockBalance[]
  lines OrderLine[]
  @@unique([orgId, sku])
  @@index([orgId])
}

model StockBalance {
  id String @id @default(cuid())
  orgId String
  productId String
  warehouseId String
  sellable Int @default(0)
  reserved Int @default(0)
  damaged Int @default(0)
  product Product @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  @@unique([productId, warehouseId])
  @@index([orgId])
}

// Append-only ledger: never update or delete rows.
model StockMovement {
  id String @id @default(cuid())
  orgId String
  productId String
  warehouseId String
  type MoveType
  qty Int
  reason String?
  actorId String
  sourceRef String?
  idempotencyKey String @unique
  createdAt DateTime @default(now())
  @@index([orgId, productId])
}

model Order {
  id String @id @default(cuid())
  orgId String
  number Int
  status OrderStatus @default(DRAFT)
  customer String
  paymentStatus PaymentStatus @default(UNPAID)
  total Decimal @db.Decimal(12,2) @default(0)
  createdAt DateTime @default(now())
  org Organization @relation(fields: [orgId], references: [id])
  lines OrderLine[]
  @@unique([orgId, number])
  @@index([orgId, status])
}

model OrderLine {
  id String @id @default(cuid())
  orderId String
  productId String
  qty Int
  unitPrice Decimal @db.Decimal(12,2)
  order Order @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model AuditLog {
  id String @id @default(cuid())
  orgId String?
  actorId String
  action String
  detail Json?
  createdAt DateTime @default(now())
  @@index([orgId, createdAt])
}

enum ReturnStatus {
  PENDING
  RESTOCKED
  DAMAGED
}

enum POStatus {
  DRAFT
  ORDERED
  PARTIAL
  RECEIVED
  CANCELLED
}

model Supplier {
  id String @id @default(cuid())
  orgId String
  name String
  phone String?
  email String?
  org Organization @relation(fields: [orgId], references: [id])
  orders PurchaseOrder[]
  @@index([orgId])
}

model PurchaseOrder {
  id String @id @default(cuid())
  orgId String
  supplierId String
  status POStatus @default(DRAFT)
  expectedOn DateTime?
  total Decimal @db.Decimal(12,2) @default(0)
  createdAt DateTime @default(now())
  org Organization @relation(fields: [orgId], references: [id])
  supplier Supplier @relation(fields: [supplierId], references: [id])
  lines PurchaseOrderLine[]
  @@index([orgId])
}

model Return {
  id String @id @default(cuid())
  orgId String
  productId String
  qty Int
  reason String?
  status ReturnStatus @default(PENDING)
  createdAt DateTime @default(now())
  org Organization @relation(fields: [orgId], references: [id])
  @@index([orgId, status])
}

model PurchaseOrderLine {
  id String @id @default(cuid())
  poId String
  productId String
  qty Int
  received Int @default(0)
  rejected Int @default(0)
  unitCost Decimal @db.Decimal(12,2)
  po PurchaseOrder @relation(fields: [poId], references: [id])
  @@index([poId])
}

model Invitation {
  id String @id @default(cuid())
  orgId String
  email String
  role Role
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  org Organization @relation(fields: [orgId], references: [id])
  @@index([orgId])
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
}

/// One row per receiving event. accepted units enter stock; rejected units never do.
model GoodsReceipt {
  id             String       @id @default(cuid())
  orgId          String
  poId           String
  lineId         String
  productId      String
  accepted       Int
  rejected       Int          @default(0)
  note           String?
  actorId        String
  idempotencyKey String       @unique
  createdAt      DateTime     @default(now())
  org            Organization @relation(fields: [orgId], references: [id])

  @@index([orgId, createdAt])
}

model Notification {
  id        String       @id @default(cuid())
  orgId     String
  kind      String
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  createdAt DateTime     @default(now())
  org       Organization @relation(fields: [orgId], references: [id])

  @@index([orgId, readAt, createdAt])
}
